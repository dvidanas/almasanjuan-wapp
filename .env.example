# Autenticación del dashboard
AUTH_SECRET=string-aleatorio-largo-para-firmar-cookies
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# Base de datos (producción — ruta persistente en VPS)
DB_PATH=/app/data/messages.db

# Baileys — sesión de WhatsApp
BAILEYS_SESSION_PATH=/app/data/baileys_session

# Backup Google Drive (opcional)
# GOOGLE_SERVICE_ACCOUNT_KEY=base64_del_json_de_service_account
# GOOGLE_DRIVE_BACKUP_FOLDER_ID=id_de_carpeta_en_drive
